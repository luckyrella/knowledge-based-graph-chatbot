# .env file - Environment variables for KG-RAG Campus Assistant
# Copy this file to .env and fill in your values

# Flask secret key (generate a random one for production)
SECRET_KEY=your-secret-key-change-in-production

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Database URL (Default: SQLite for local; PostgreSQL on Render / Neon.tech)
# DATABASE_URL=postgresql+psycopg://username:password@ep-cool-server.neon.tech/neondb?sslmode=require

# Neo4j Graph Database (Get free cloud instance from https://neo4j.com/cloud/aura-free)
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-neo4j-password
# NEO4J_DATABASE=neo4j

